<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.happyhai.springai.alibaba</groupId>
        <artifactId>S09-springai-alibaba-mcp</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>SM01-springai-alibaba-mcp-auth-server</artifactId>

    <description>
        MCP 独立授权服务器,基于 mcp-authorization-server,只负责签发 MCP 调用的 OAuth2 访问令牌,
        不与业务系统登录耦合。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MCP 授权服务器:在 Spring Authorization Server 之上加 MCP 规范的扩展
             (Dynamic Client Registration、Resource Indicators 等) -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>mcp-authorization-server</artifactId>
            <version>0.0.6</version>
        </dependency>

        <!-- Spring 官方的 OAuth2 授权服务器核心,mcp-authorization-server 是在它之上做扩展 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-authorization-server</artifactId>
        </dependency>
    </dependencies>
</project>