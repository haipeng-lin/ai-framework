<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.happyhai.springai.alibaba</groupId>
        <artifactId>S09-springai-alibaba-mcp</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>SM02-springai-alibaba-mcp-server</artifactId>

    <description>
        MCP 服务器(本仓库内的实现),对外暴露若干工具,
        用 mcp-server-security 校验来自 SM01 授权服务器的 JWT。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MCP 服务端 (webmvc 传输) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- MCP 服务端 OAuth2 资源服务器校验:JWT 必须由 SM01 的 issuer-uri 签发 -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>mcp-server-security</artifactId>
            <version>0.0.6</version>
        </dependency>

        <!-- Spring 官方资源服务器,被 mcp-server-security 复用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
    </dependencies>
</project>